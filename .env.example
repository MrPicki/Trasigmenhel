# Copy this file to .env.local (never committed) and fill in the real key.
#
# Web3Forms powers the newsletter signup form with no backend needed.
# 1. Go to https://web3forms.com and enter kontakt@trasigmenhel.se
# 2. You'll get an access key by e-mail — paste it below.
# 3. Also add it as a GitHub Actions / build secret named VITE_WEB3FORMS_KEY
#    if you automate deploys; for `npm run deploy` from your own machine,
#    .env.local is enough.
VITE_WEB3FORMS_KEY=
